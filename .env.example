# HEEEHABABY 雛型環境變數範本
# 複製為 .env 後填入實際值。實際值不得進版本控制。

PORT=3000

# 簽章金鑰 —— 僅存於伺服器端 (README §10.2 / F-16)
QR_SIGNING_KEY=

# 後台登入 token 簽發金鑰 (雛型用；正式版改為 LIFF ID Token / Supabase JWT 驗證)
SESSION_SIGNING_KEY=

# 預設匯率 JPY -> TWD，會寫入 settings.fx_jpy_twd 初始值
FX_JPY_TWD=0.215

# 雛型資料庫檔案位置
DB_PATH=./data/prototype.db

# ---- 以下為正式串接時才需要，雛型未使用 ----
# N8N_BASE_URL=
# N8N_API_KEY=
# GS_SPREADSHEET_ID=
# GS_CREDENTIAL_ID=
# LINE_CREDENTIAL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OA_ID=
# OWNER_LINE_USER_ID=
# OPENAI_CREDENTIAL_ID=
# GEMINI_API_KEY=
# DRIVE_CREDENTIAL_ID=
# ERROR_WORKFLOW_ID=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
