        "url": "={{ $('設定').first().json.api_base }}/api/v1/notify/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ notif_id: $json.notif_id, ok: $json.ok, error: $json.error, line_response: $json.line_response }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "2515cbe3-5668-5493-a16b-751693905f6c",
      "name": "回報結果",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
